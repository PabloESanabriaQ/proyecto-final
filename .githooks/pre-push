#!/usr/bin/env bash
# Puerta local antes del push (decisión 0016, convenciones.md §2).
#
# Por cada rama que se sube:
# 1. Calcula el diff acumulado entre origin/main y el commit que se va a subir.
# 2. Corre lint y tests de las partes tocadas (no gasta una revisión sobre código roto).
#    Lint y tests corren sobre el árbol de trabajo; el agente revisa el commit. Si hay cambios
#    sin commitear el hook avisa, porque pueden diverger.
# 3. Pide la revisión al agente (Claude Code en modo no interactivo, solo lectura) y bloquea el
#    push si el veredicto es BLOQUEADO. La salida queda en .review/ para pegarla en el PR.
#
# Activar una vez por clon:  git config core.hooksPath .githooks
# Descartar un bloqueante que no aplica (queda escrito en la salida, y el motivo va al PR):
#   AULERO_REVIEW_DESCARTAR="motivo" git push
#
# Variables para tests (.githooks/tests/test_pre_push.sh): AULERO_HOOK_SIN_CHEQUEOS=1 saltea
# lint y tests (pero registra qué hubiera corrido en $AULERO_HOOK_REGISTRO); CLAUDE_BIN apunta a
# otro ejecutable en lugar de `claude`; AULERO_HOOK_TIMEOUT tope en segundos para el agente.
set -euo pipefail

RAIZ="$(git rev-parse --show-toplevel)"
cd "$RAIZ"

# mise puede no estar activado en el shell del hook; con `mise x` se usan las versiones del repo.
# La expansión ${MX[@]+"${MX[@]}"} tolera el array vacío en bash 3.2 (macOS) con `set -u`.
if command -v mise >/dev/null 2>&1; then
  MX=(mise x --)
else
  MX=()
fi
mx() { ${MX[@]+"${MX[@]}"} "$@" </dev/null; }

CLAUDE_BIN="${CLAUDE_BIN:-claude}"
TIMEOUT_AGENTE="${AULERO_HOOK_TIMEOUT:-600}"
if command -v timeout >/dev/null 2>&1; then
  CON_TIMEOUT=(timeout "$TIMEOUT_AGENTE")
elif command -v gtimeout >/dev/null 2>&1; then
  CON_TIMEOUT=(gtimeout "$TIMEOUT_AGENTE")
else
  CON_TIMEOUT=()
fi

log() { printf '\033[1;34m[pre-push]\033[0m %s\n' "$*"; }
aviso() { printf '\033[1;33m[pre-push]\033[0m %s\n' "$*" >&2; }
fallo() { printf '\033[1;31m[pre-push]\033[0m %s\n' "$*" >&2; exit 1; }

# Patrones de qué toca cada parte. CI (.github/workflows/ci.yml) usa las mismas listas; si se
# cambia una, se cambia la otra.
PAT_PYTHON='^(backend|solver)/|^pyproject\.toml$|^uv\.lock$|^mise\.toml$'
PAT_FRONTEND='^frontend/|^mise\.toml$'
PAT_HOOK='^\.githooks/'
PAT_INFRA='^\.github/|^docker-compose\.yml$|^\.editorconfig$|^\.gitignore$'
# Archivos que no vale la pena mandar al agente: generados, enormes, sin decisiones adentro.
EXCLUIR_DEL_DIFF=(':!uv.lock' ':!**/package-lock.json' ':!*.tsbuildinfo')

# --- Base del diff -----------------------------------------------------------------------------
# origin/main actualizada. Sin red, la última origin/main conocida. Si el remoto todavía no tiene
# main (primer push del repo), main local; si tampoco existe, el árbol vacío (se revisa todo).
if git fetch -q origin main 2>/dev/null; then
  REF_BASE="origin/main"
elif git rev-parse -q --verify origin/main >/dev/null; then
  aviso "No se pudo actualizar origin/main (¿sin red?); se usa la última conocida."
  REF_BASE="origin/main"
elif git rev-parse -q --verify main >/dev/null; then
  log "origin/main no existe todavía; se usa main local como base."
  REF_BASE="main"
else
  log "No hay main: se revisa el contenido completo."
  REF_BASE="$(git hash-object -t tree /dev/null)"
fi

if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
  aviso "Hay cambios sin commitear: lint y tests corren sobre el árbol de trabajo, el agente revisa el commit. Commiteá todo para que coincidan."
fi

registrar() { [[ -n "${AULERO_HOOK_REGISTRO:-}" ]] && echo "$1" >>"$AULERO_HOOK_REGISTRO"; return 0; }

revisar_ref() {
  local ref_local="$1" sha_local="$2"
  local base archivos toca_python=false toca_frontend=false toca_hook=false toca_codigo=false

  base="$(git merge-base "$REF_BASE" "$sha_local" 2>/dev/null || echo "$REF_BASE")"
  archivos="$(git diff --name-only "$base" "$sha_local")"

  if [[ -z "$archivos" ]]; then
    log "$ref_local: sin cambios respecto de $REF_BASE. Nada que revisar."
    return 0
  fi

  /usr/bin/grep -qE "$PAT_PYTHON" <<<"$archivos" && toca_python=true
  /usr/bin/grep -qE "$PAT_FRONTEND" <<<"$archivos" && toca_frontend=true
  /usr/bin/grep -qE "$PAT_HOOK" <<<"$archivos" && toca_hook=true
  if $toca_python || $toca_frontend || $toca_hook || /usr/bin/grep -qE "$PAT_INFRA" <<<"$archivos"; then
    toca_codigo=true
  fi

  # --- Lint y tests de lo tocado ---
  if $toca_python; then
    registrar python
    if [[ -z "${AULERO_HOOK_SIN_CHEQUEOS:-}" ]]; then
      log "Python: ruff, mypy, import-linter, pytest"
      mx uv run ruff check backend solver
      mx uv run ruff format --check backend solver
      (cd solver && mx uv run mypy .)
      (cd backend && mx uv run mypy .)
      mx uv run lint-imports
      mx uv run pytest
    fi
  fi
  if $toca_frontend; then
    registrar frontend
    if [[ -z "${AULERO_HOOK_SIN_CHEQUEOS:-}" ]]; then
      log "Frontend: eslint, prettier, tsc, vitest"
      (cd frontend && mx npm run --silent lint && mx npm run --silent format:check \
        && mx npm run --silent typecheck && mx npm run --silent test)
    fi
  fi
  if $toca_hook; then
    registrar hook
    if [[ -z "${AULERO_HOOK_SIN_CHEQUEOS:-}" ]]; then
      log "Hook: tests del pre-push"
      bash .githooks/tests/test_pre_push.sh </dev/null
    fi
  fi

  # --- Revisión del agente ---
  if ! $toca_codigo; then
    log "$ref_local: solo documentación u otros archivos sin código. No se invoca al agente."
    return 0
  fi

  command -v "$CLAUDE_BIN" >/dev/null 2>&1 \
    || fallo "No se encontró '$CLAUDE_BIN' en el PATH. Instalá Claude Code (README) o, si es una emergencia, avisá en el PR."

  mkdir -p .review
  local corto salida diff prompt respuesta estado texto veredicto
  corto="$(git rev-parse --short "$sha_local")"
  salida=".review/${corto}.md"
  diff="$(git diff "$base" "$sha_local" -- . "${EXCLUIR_DEL_DIFF[@]}")"
  prompt="$(cat .githooks/revision-prompt.md)"

  log "Revisión del agente: $ref_local, $(wc -l <<<"$archivos" | tr -d ' ') archivo(s) (${base:0:7}..${corto}). Suele tardar 1–3 minutos (tope: ${TIMEOUT_AGENTE}s)."
  set +e
  # Cerca de seis acentos: un diff puede contener ``` (por ejemplo, un README).
  respuesta="$(printf '%s\n\n## Diff a revisar\n\n``````diff\n%s\n``````\n' "$prompt" "$diff" \
    | ${CON_TIMEOUT[@]+"${CON_TIMEOUT[@]}"} "$CLAUDE_BIN" -p --output-format json --allowedTools Read Grep Glob --max-turns 40 2>.review/error.log)"
  estado=$?
  set -e
  if [[ $estado -eq 124 ]]; then
    fallo "El agente no respondió en ${TIMEOUT_AGENTE}s. Reintentá, o subí el tope con AULERO_HOOK_TIMEOUT."
  fi
  if [[ $estado -ne 0 || -z "$respuesta" ]]; then
    fallo "El agente no respondió (código $estado). Detalle en .review/error.log: $(head -c 300 .review/error.log | tr '\n' ' ')"
  fi

  texto="$(python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("result",""))' <<<"$respuesta")" \
    || fallo "No se pudo leer la respuesta del agente (no es JSON). Guardada en .review/error.log."

  {
    printf '# Revisión del agente — %s\n\n' "$corto"
    printf 'Rama: %s · Base: %s · Fecha: %s\n\n' "${ref_local#refs/heads/}" "${base:0:7}" "$(date -Is)"
    printf '%s\n' "$texto"
  } >"$salida"
  cp "$salida" .review/ultima.md

  # Solo cuenta una línea que sea exactamente el veredicto (el prompt lo pide como última línea).
  veredicto="$(/usr/bin/grep -oE '^VEREDICTO: *(APROBADO|BLOQUEADO) *$' <<<"$texto" | tail -1 | /usr/bin/grep -oE 'APROBADO|BLOQUEADO' || true)"

  case "$veredicto" in
    APROBADO)
      log "APROBADO. Salida en $salida — pegala en la descripción del PR."
      ;;
    BLOQUEADO)
      if [[ -n "${AULERO_REVIEW_DESCARTAR:-}" ]]; then
        printf '\n---\n**Bloqueante descartado por el autor:** %s\n' "$AULERO_REVIEW_DESCARTAR" >>"$salida"
        cp "$salida" .review/ultima.md
        log "BLOQUEADO, descartado por el autor: \"$AULERO_REVIEW_DESCARTAR\". Quedó escrito en $salida; ese motivo va al PR."
      else
        printf '\n%s\n\n' "$texto" >&2
        fallo "BLOQUEADO. Corregí y volvé a pushear, o descartá con AULERO_REVIEW_DESCARTAR=\"motivo\". Detalle en $salida."
      fi
      ;;
    *)
      printf '\n%s\n\n' "$texto" >&2
      fallo "El agente no emitió un veredicto reconocible. Salida en $salida."
      ;;
  esac
}

# stdin: <ref local> <sha local> <ref remoto> <sha remoto>, una línea por ref que se sube.
CERO="0000000000000000000000000000000000000000"
while read -r ref_local sha_local _ref_remoto _sha_remoto; do
  [[ -z "$ref_local" ]] && continue
  [[ "$sha_local" == "$CERO" ]] && continue # borrado de rama remota: nada que revisar
  revisar_ref "$ref_local" "$sha_local"
done
